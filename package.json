{
  "name": "momom",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/language-server",
    "packages/vscode-extension"
  ],
  "scripts": {
    "build:core": "npm --workspace @momom/core run build",
    "build:cli": "npm --workspace @momom/cli run build",
    "build:language-server": "npm --workspace @momom/language-server run build",
    "build:vscode": "npm --workspace @momom/vscode-extension run build",
    "watch:vscode": "npm --workspace @momom/vscode-extension run watch",
    "build": "npm run build:core && npm run build:cli && npm run build:language-server && npm run build:vscode",
    "test": "npm run build && node --require ./vitest-sandbox.cjs ./node_modules/vitest/vitest.mjs run --pool threads --poolOptions.threads.singleThread --no-file-parallelism",
    "test:watch": "node --require ./vitest-sandbox.cjs ./node_modules/vitest/vitest.mjs --pool threads --poolOptions.threads.singleThread --no-file-parallelism",
    "momom": "node ./packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
