{
  "name": "momom",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "npm --workspace @momom/core run build",
    "build:cli": "npm --workspace @momom/cli run build",
    "build": "npm run build:core && npm run build:cli",
    "test": "npm run build && node --require ./vitest-sandbox.cjs ./node_modules/vitest/vitest.mjs run --pool threads --poolOptions.threads.singleThread --no-file-parallelism",
    "test:watch": "node --require ./vitest-sandbox.cjs ./node_modules/vitest/vitest.mjs --pool threads --poolOptions.threads.singleThread --no-file-parallelism",
    "momom": "node ./packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
